# The scripts write their LaTeX output into tables/ and figures/.  Those are
# inputs to the manuscript, which is not part of this repository, so they are
# regenerated rather than tracked.
tables/*
figures/*
!tables/.gitkeep
!figures/.gitkeep

# code/results/ IS tracked: it is the raw output of the four Monte Carlo
# studies, which take hours, and run_paper.R reads it.  See README.md.

# R and LaTeX leftovers
.Rhistory
.RData
.Rproj.user/
*.Rproj
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
